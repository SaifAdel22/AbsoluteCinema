@model AbsoluteCinema.ViewModels.CinemaVM

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-white">Cinema Details: <span class="fw-bold">@Model.Name</span></h5>
        <a asp-action="Index" class="btn btn-sm btn-light text-primary">Back to Cinemas List</a>
    </div>
    <div class="card-body">
        <div class="row mb-4 align-items-center">
            <div class="col-md-3 text-center mb-3 mb-md-0">
                @{
                    var cinemaImg = string.IsNullOrWhiteSpace(Model.ExistingCinemaLogo)
                        ? "/assets/img/generic/placeholder.png"
                        : (Model.ExistingCinemaLogo.StartsWith("/") || Model.ExistingCinemaLogo.StartsWith("~")
                            ? Url.Content(Model.ExistingCinemaLogo)
                            : Url.Content("~/images/cinemas/" + Model.ExistingCinemaLogo));
                }
                <img src="@cinemaImg" class="img-fluid rounded border shadow-sm w-100" style="max-height: 200px; object-fit: cover;" alt="@Model.Name"
                     onerror="this.onerror=null; this.src='https://via.placeholder.com/300x200?text=No+Logo';" />
            </div>
            <div class="col-md-9">
                <h3 class="fw-bold mb-2">@Model.Name</h3>
               
            </div>
        </div>

        <hr />

        <h6 class="mb-3 text-700">Movies Currently Showing (@Model.Movies.Count Movies)</h6>

        @if (!Model.Movies.Any())
        {
            <div class="alert alert-info border-0">No movies currently assigned to this cinema.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var movie in Model.Movies)
                {
                    <div class="col-md-4 col-lg-3">
                        <div class="card h-100 border overflow-hidden shadow-sm">
                            @{
                                var movieImg = string.IsNullOrWhiteSpace(movie.ExistingMainImg)
                                    ? "/assets/img/generic/placeholder.png"
                                    : (movie.ExistingMainImg.StartsWith("/") || movie.ExistingMainImg.StartsWith("~")
                                        ? Url.Content(movie.ExistingMainImg)
                                        : Url.Content("~/images/movies/main/" + movie.ExistingMainImg));
                            }
                            <div style="height: 240px; width: 100%;" class="bg-200">
                                <img src="@movieImg" class="card-img-top w-100 h-100" style="object-fit: cover;" alt="@movie.Title"
                                     onerror="this.onerror=null; this.src='https://via.placeholder.com/300x400?text=No+Image';" />
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <h6 class="card-title fw-bold text-truncate mb-1">@movie.Title</h6>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-success">$@movie.Price</span>
                                        <small class="text-muted"><i class="far fa-clock me-1"></i>@movie.StartDate.ToString("dd MMM")</small>
                                    </div>
                                </div>
                                <a asp-area="Admin" asp-controller="Movie" asp-action="Details" asp-route-id="@movie.Id" class="btn btn-sm btn-outline-primary w-100 mt-2">
                                    <i class="fas fa-film me-1"></i> View Movie
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>