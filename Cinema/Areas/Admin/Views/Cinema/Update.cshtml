@model AbsoluteCinema.ViewModels.CinemaVM

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="mb-0 fw-bold">Update Cinema</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Update" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <!-- Hidden Fields -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ExistingCinemaLogo" />

                        <!-- Cinema Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Cinema Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                     <!-- Cinema Logo & Preview -->
<div class="mb-4">
    <label asp-for="CinemaLogo" class="form-label fw-bold">Update Logo</label>
    <input asp-for="CinemaLogo" type="file" class="form-control" id="logoInput" accept="image/*" />
    <span asp-validation-for="CinemaLogo" class="text-danger"></span>

    <!-- معاينة الصورة (تعديل المسار ليحتوي على اسم المجلد الصحيح) -->
    <div class="mt-3">
        <label class="form-label text-muted d-block mb-1">Current / New Logo Preview:</label>
        
        @{
            // حط هنا اسم المجلد اللي الصور متحفظة فيه عندك في الـ wwwroot (مثلاً /images/cinemas/ أو /images/)
            string folderPath = "/images/cinemas/"; 
            
            var fullImagePath = "";
            if (!string.IsNullOrEmpty(Model.ExistingCinemaLogo))
            {
                // لو المسار مش باصي الـ folder، بنلزقه فيه
                fullImagePath = Model.ExistingCinemaLogo.StartsWith("http") || Model.ExistingCinemaLogo.StartsWith("/") 
                    ? Model.ExistingCinemaLogo 
                    : folderPath + Model.ExistingCinemaLogo;
            }
        }

        <img id="logoPreview" 
             src="@(!string.IsNullOrEmpty(fullImagePath) ? fullImagePath : "#")" 
             alt="Cinema Logo" 
             class="rounded shadow-sm @(string.IsNullOrEmpty(fullImagePath) ? "d-none" : "")" 
             style="width: 100px; height: 100px; object-fit: cover;" />
    </div>
</div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-warning text-dark fw-bold">
                                <i class="fas fa-save me-1"></i> Update Cinema
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        // دالة تبديل وعرض الصورة الجديدة فور اختيارها ووضعها مكان القديمة
        document.getElementById('logoInput').addEventListener('change', function (event) {
            const file = event.target.files[0];
            const preview = document.getElementById('logoPreview');
            
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result; // تبديل الـ src للصورة الجديدة
                    preview.classList.remove('d-none'); // إظهار الصورة لو كانت مخفية
                }
                reader.readAsDataURL(file);
            }
        });

        @if (TempData["success"] != null)
        {
            <text>
                toastr.success('@TempData["success"]', 'Success', {
                    positionClass: 'toast-top-right',
                    timeOut: 3000
                });
            </text>
        }
    </script>
}