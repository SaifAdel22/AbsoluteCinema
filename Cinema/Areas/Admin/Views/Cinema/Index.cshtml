@model IEnumerable<AbsoluteCinema.ViewModels.CinemaVM>

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-white">Cinemas Management</h5>
        <a asp-action="Create" class="btn btn-sm btn-light text-primary">
            <i class="fas fa-plus me-1"></i> Add New Cinema
        </a>
    </div>
    <div class="card-body">
        <!-- نموذج البحث -->
        <form asp-action="Index" method="get" class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text" name="query" value="@Context.Request.Query["query"]" class="form-control" placeholder="Search cinema by name..." />
                    <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> Search</button>
                    @if (!string.IsNullOrEmpty(Context.Request.Query["query"]))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                    }
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Logo</th>
                        <th>Name</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                No cinemas found in the database. Try adding a new cinema!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                 <td>
                                    @{
                                        var imagePath = string.IsNullOrEmpty(item.ExistingCinemaLogo) ? "/assets/img/generic/placeholder.png" :
                                                        (item.ExistingCinemaLogo.StartsWith("images/") || item.ExistingCinemaLogo.StartsWith("/")
                                                            ? "/" + item.ExistingCinemaLogo.TrimStart('/')
                                                            : "/images/cinemas/" + item.ExistingCinemaLogo);
                                    }
                                    <img src="@imagePath" alt="@item.Name" class="rounded shadow-sm" style="width: 45px; height: 65px; object-fit: cover;" onerror="this.src='/assets/img/generic/placeholder.png'" />
                                </td>
                                <td class="fw-bold">@item.Name</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white me-1">Details</a>
                                    <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white me-1">Edit</a>
<!-- زرار الحذف في الجدول -->
<button type="button" class="btn btn-danger btn-sm" onclick="deleteCinema(@item.Id)">
    <i class="fas fa-trash"></i> Delete
</button>                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- أزرار التنقل بين الصفحات -->
<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
    <nav>
        <ul class="pagination mb-0">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage - 1)" asp-route-query="@ViewBag.SearchQuery">Previous</a>
            </li>
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-query="@ViewBag.SearchQuery">@i</a>
                </li>
            }
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages || ViewBag.TotalPages == 0 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage + 1)" asp-route-query="@ViewBag.SearchQuery">Next</a>
            </li>
        </ul>
    </nav>
</div>

                    @section Scripts {
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function deleteCinema(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    // إرسال طلب الـ Delete عن طريق الـ AJAX
                    $.ajax({
                        url: '@Url.Action("Delete", "Cinema", new { area = "Admin" })',
                        type: 'POST',
                        data: {
                            id: id,
                            // لو الـ Controller محتاج الـ AntiForgeryToken مع الـ Ajax
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire(
                                    'Deleted!',
                                    response.message,
                                    'success'
                                ).then(() => {
                                    location.reload(); // إعادة تحميل الصفحة لتحديث الجدول
                                });
                            } else {
                                Swal.fire(
                                    'Error!',
                                    response.message,
                                    'error'
                                );
                            }
                        },
                        error: function () {
                            Swal.fire(
                                'Error!',
                                'Something went wrong while deleting.',
                                'error'
                            );
                        }
                    });
                }
            });
        }
    </script>
}