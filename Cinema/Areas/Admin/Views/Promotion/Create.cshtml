@model AbsoluteCinema.ViewModels.PromotionVM

@{
    ViewData["Title"] = Model?.Id == 0 ? "Create Promotion" : "Edit Promotion";
}

<div class="container px-4">
    <h2 class="mt-4">@ViewData["Title"]</h2>

    <div class="card mb-4 mt-3">
        <div class="card-body">
            <form asp-action="@(Model?.Id == 0 ? "Create" : "Update")" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Discount" class="form-label"></label>
                    <input asp-for="Discount" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Discount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaxUsage" class="form-label"></label>
                    <input asp-for="MaxUsage" class="form-control" type="number" />
                    <span asp-validation-for="MaxUsage" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ValidTo" class="form-label"></label>
                    <input asp-for="ValidTo" class="form-control" type="datetime-local" />
                    <span asp-validation-for="ValidTo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MovieId" class="form-label"></label>
                    <select asp-for="MovieId" asp-items="Model.Movies" class="form-select">
                        <option value="">-- General Promotion (All Movies) --</option>
                    </select>
                    <span asp-validation-for="MovieId" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Status" class="form-check-input" />
                    <label asp-for="Status" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-success">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}