@model AbsoluteCinema.ViewModels.ActorVM

@{
    ViewData["Title"] = "Create Actor";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Create Actor</h1>
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data" id="createForm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter actor name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProfileImgFile" class="form-label fw-bold">Profile Image</label>
                    <input asp-for="ProfileImgFile" type="file" id="profileImgInput" class="form-control" accept="image/*" />
                    <span asp-validation-for="ProfileImgFile" class="text-danger"></span>
                </div>

                <!-- Preview Image -->
                <div class="mb-3">
                    <label class="form-label text-muted small">Image Preview:</label>
                    <div>
                        <img id="imagePreview" src="#" alt="Preview" class="img-thumbnail d-none shadow-sm" style="max-height: 160px; object-fit: cover;" />
                    </div>
                </div>

                <button type="submit" id="submitBtn" class="btn btn-primary"><i class="fas fa-save"></i> Create Actor</button>
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // تفعيل التحقق الفوري أثناء الكتابة
        $(document).ready(function() {
            var form = $("#createForm");
            if (form.length && form.data("validator")) {
                form.data("validator").settings.onkeyup = function(element, event) {
                    $(element).valid();
                };
            }
        });

        // معاينة الصورة لحظياً
        document.getElementById('profileImgInput').addEventListener('change', function(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('imagePreview');
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            }
        });

        // منع إرسال الفورم مرتين بشرط صحة الـ Validation أولاً
        document.getElementById('createForm').addEventListener('submit', function(e) {
            if (!$(this).valid()) {
                return;
            }
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerText = "Saving...";
        });
    </script>
}