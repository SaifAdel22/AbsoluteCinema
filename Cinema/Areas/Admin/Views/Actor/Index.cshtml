@model IEnumerable<AbsoluteCinema.ViewModels.ActorDetailsVM>

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-white">Actors Management</h5>
        <a asp-action="Create" class="btn btn-sm btn-light text-primary">
            <i class="fas fa-plus me-1"></i> Add New Actor
        </a>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text" name="query" value="@Context.Request.Query["query"]" class="form-control" placeholder="Search actor by name..." />
                    <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> Search</button>
                    @if (!string.IsNullOrEmpty(Context.Request.Query["query"]))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                    }
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Profile</th>
                        <th>Name</th>
                        <th>Movies</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No actors found.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="~/images/actors/@item.ProfilePicture" class="rounded-circle" style="width: 45px; height: 45px; object-fit: cover;" onerror="this.src='/assets/img/generic/placeholder.png'" />
                                </td>
                                <td class="fw-bold">@item.ActorName</td>
                                <td>
                                    @if (item.Movies != null && item.Movies.Any())
                                    {
                                        foreach (var movie in item.Movies)
                                        {
                                            <span class="badge bg-secondary me-1">@movie.Title</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No movies</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.ActorId" class="btn btn-sm btn-info text-white me-1">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.ActorId" class="btn btn-sm btn-warning text-white me-1">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.ActorId" class="btn btn-sm btn-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- أزرار التنقل بين الصفحات -->
<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
    <nav>
        <ul class="pagination mb-0">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage - 1)" asp-route-query="@ViewBag.SearchQuery">Previous</a>
            </li>
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-query="@ViewBag.SearchQuery">@i</a>
                </li>
            }
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages || ViewBag.TotalPages == 0 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(ViewBag.CurrentPage + 1)" asp-route-query="@ViewBag.SearchQuery">Next</a>
            </li>
        </ul>
    </nav>
</div>