@model AbsoluteCinema.ViewModels.MovieVM

@{
    ViewData["Title"] = "Create Movie";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Create Movie</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Movies</a></li>
        <li class="breadcrumb-item active">Create</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-plus me-1"></i>
            Add New Movie
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <!-- Title -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="Enter movie title" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <!-- Price -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- Category -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <!-- Cinema -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="CinemaId" class="form-label"></label>
                        <select asp-for="CinemaId" asp-items="Model.Cinemas" class="form-select">
                            <option value="">-- Select Cinema --</option>
                        </select>
                        <span asp-validation-for="CinemaId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- Start Date -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" class="form-control" type="datetime-local" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <!-- Status -->
                    <div class="col-md-6 mb-3 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" asp-for="Status" checked />
                            <label class="form-check-label" asp-for="Status">Is Active</label>
                        </div>
                    </div>
                </div>

                <!-- Actors (Select2 with Tags & X button) -->
                <div class="mb-3">
                    <label asp-for="SelectedActorIds" class="form-label"></label>
                    <select asp-for="SelectedActorIds" asp-items="Model.Actors" class="form-control select2-multiple" multiple="multiple">
                    </select>
                    <span asp-validation-for="SelectedActorIds" class="text-danger"></span>
                </div>

                <!-- Main Image -->
                <div class="mb-3">
                    <label asp-for="MainImg" class="form-label"></label>
                    <input asp-for="MainImg" class="form-control" type="file" />
                    <span asp-validation-for="MainImg" class="text-danger"></span>
                </div>

                <!-- Sub Images -->
                <div class="mb-3">
                    <label asp-for="NewSubImages" class="form-label"></label>
                    <input asp-for="NewSubImages" class="form-control" type="file" multiple />
                    <span asp-validation-for="NewSubImages" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter movie description"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Submit Button -->
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Create Movie</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- Toastr CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <!-- 1. نزل الـ Validation Scripts الأساسية الأول -->
    <partial name="_ValidationScriptsPartial" />

    <!-- 2. نزل الـ Select2 و Toastr JS بعدها -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        $(document).ready(function() {
            // تفعيل الـ Select2
            var $select = $('.select2-multiple').select2({
                placeholder: "Select actors...",
                allowClear: true,
                width: '100%'
            });

            // حل مشكلة الـ Validation مع الـ Select2:
            // بما إن الـ Select2 بيخفي الـ select الأصلي، بنخلي الـ validator يبص على العنصر اللي Select2 عمله
            if ($.validator && $.validator.setDefaults) {
                $.validator.setDefaults({
                    ignore: ":hidden:not(.select2-hidden-accessible)"
                });
            }

            // لما نختار أو نمسح ممثل، نخلي الـ select الأصلي يسمع التغيير ويحدث الـ Validation فوراً
            $select.on('change', function () {
                $(this).valid();
            });
        });

        // معاينة الصورة (تشتغل في الـ Update بس لو موجودة)
        const mainImageInput = document.getElementById('mainImageInput');
        if (mainImageInput) {
            mainImageInput.addEventListener('change', function(event) {
                const file = event.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const preview = document.getElementById('mainImagePreview');
                        const noText = document.getElementById('noMainImageText');
                        if (preview) {
                            preview.src = e.target.result;
                            preview.classList.remove('d-none');
                        }
                        if (noText) {
                            noText.style.display = 'none';
                        }
                    }
                    reader.readAsDataURL(file);
                }
            });
        }

        // إظهار رسائل الـ Toastr
        @if (TempData["schema"] != null || TempData["success"] != null)
        {
            <text>
                toastr.success('@TempData["success"]', 'Success', { positionClass: 'toast-top-right', timeOut: 3000 });
            </text>
        }
        @if (TempData["error"] != null)
        {
            <text>
                toastr.error('@TempData["error"]', 'Error', { positionClass: 'toast-top-right', timeOut: 3000 });
            </text>
        }
    </script>
}