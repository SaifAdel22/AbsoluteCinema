@model AbsoluteCinema.ViewModels.MovieVM

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-white">Movie Details: @Model.Title</h5>
        <a asp-action="Index" class="btn btn-sm btn-light text-primary">Back to Movies List</a>
    </div>
    <div class="card-body">
        <!-- معلومات الفيلم الأساسية والصورة الرئيسية -->
        <div class="row align-items-center mb-4">
            <div class="col-md-4 text-center mb-3 mb-md-0">
                @{
                    var mainImgPath = string.IsNullOrEmpty(Model.ExistingMainImg) ? "/assets/img/generic/placeholder.png" :
                                      (Model.ExistingMainImg.StartsWith("images/") || Model.ExistingMainImg.StartsWith("/")
                                          ? "/" + Model.ExistingMainImg.TrimStart('/')
                                          : "/images/movies/main/" + Model.ExistingMainImg);
                }
                <img src="@mainImgPath" class="img-fluid rounded shadow" style="max-height: 320px; width: 100%; object-fit: cover;" onerror="this.src='/assets/img/generic/placeholder.png'" />
            </div>
            <div class="col-md-8">
                <h2 class="fw-bold text-primary">@Model.Title</h2>
                <h4 class="text-success mb-3">$@Model.Price</h4>
                <hr />
                <h5 class="text-muted fs-6 text-uppercase fw-bold">Description</h5>
                <div class="p-3 bg-light rounded border" style="max-height: 180px; overflow-y: auto;">
                    <p class="mb-0 text-secondary" style="line-height: 1.6;">
                        @(string.IsNullOrEmpty(Model.Description) ? "No description available for this movie." : Model.Description)
                    </p>
                </div>
            </div>
        </div>

        <hr />
        <!-- Cast / Actors -->
        <div class="row mt-4">
            <h5 class="text-muted mb-3"><i class="fas fa-users me-2"></i>Cast / Actors</h5>
            @if (Model.MovieActors != null && Model.MovieActors.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var actorVm in Model.MovieActors)
                    {
                        <a asp-controller="Actor" asp-action="Details" asp-route-id="@actorVm.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm text-decoration-none">
                            <i class="fas fa-user-circle me-1"></i> @actorVm.Name
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="col-12">
                    <p class="text-muted fst-italic">No actors assigned to this movie yet.</p>
                </div>
            }
        </div>
        <hr />
        <!-- Movie Gallery / Sub Images -->
        <div class="row mt-4">
            <h5 class="text-muted mb-3"><i class="fas fa-images me-2"></i>Movie Gallery / Sub Images</h5>
            @if (Model.ExistingSubImages != null && Model.ExistingSubImages.Any())
            {
                foreach (var subImg in Model.ExistingSubImages)
                {
                    <div class="col-md-3 mb-3">
                        <div class="card shadow-sm">
                            @{
                                var subImgPath = string.IsNullOrEmpty(subImg.Img) ? "/assets/img/generic/placeholder.png" :
                                                 (subImg.Img.StartsWith("images/") || subImg.Img.StartsWith("/")
                                                     ? "/" + subImg.Img.TrimStart('/')
                                                     : "/images/movies/sub/" + subImg.Img);
                            }
                            <img src="@subImgPath" class="card-img-top rounded" style="height: 150px; object-fit: cover;" onerror="this.src='/assets/img/generic/placeholder.png'" />
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p class="text-muted fst-italic">No additional sub images available for this movie.</p>
                </div>
            }
        </div>
    </div>
    <div class="card-footer text-end bg-light">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning text-white me-2">Edit Movie</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>