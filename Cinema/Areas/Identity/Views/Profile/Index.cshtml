@model AbsoluteCinema.ViewModels.UserProfileVM

@{
    ViewData["Title"] = "Account Settings";
}

<div class="container my-4">
    <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0 text-primary">Account Settings</h4>
            <p class="text-muted text-sm mb-0">Update your profile information and manage your password.</p>
        </div>
        <div class="card-body p-4">

            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Personal Information Section -->
                <h5 class="mb-3 text-secondary">Personal Information</h5>
                <hr />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label font-weight-bold"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label font-weight-bold"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label font-weight-bold"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label font-weight-bold"></label>
                    <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="new-password" placeholder="Leave blank if you don't want to change" />
                    <!-- تأكد إن دي تخص الـ CurrentPassword فقط -->
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="NewPassword" class="form-label font-weight-bold"></label>
                        <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                        <!-- تأكد إن دي تخص الـ NewPassword فقط -->
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmNewPassword" class="form-label font-weight-bold"></label>
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password" />
                        <!-- دي بقى اللي المفروض تطلع تحتها إيرور التطابق، فلو كانت طايرة فوق، نزلها مكانها تحت الـ ConfirmNewPassword -->
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                    </div>
                </div>
 
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>

        </div>
    </div>
</div>

