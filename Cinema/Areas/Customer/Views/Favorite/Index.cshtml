@model IEnumerable<AbsoluteCinema.Models.Favorite>

@{
    ViewData["Title"] = "My Favorite Movies";
}

<div class="container my-4">
    <h2 class="fw-bold text-danger mb-4"><i class="fas fa-heart me-2"></i> My Favorite Movies</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                var imgPath = string.IsNullOrEmpty(item.Movie?.MainImg) ? "/assets/img/generic/placeholder.png" :
                            (item.Movie.MainImg.StartsWith("images/") || item.Movie.MainImg.StartsWith("/")
                                ? "/" + item.Movie.MainImg.TrimStart('/')
                                : "/images/movies/main/" + item.Movie.MainImg);

                <div class="col">
                    <div class="card h-100 shadow-sm border-0 position-relative">
                        <!-- زر الحذف من المفضلة -->
                        <form asp-action="RemoveFromFavorites" asp-route-movieId="@item.MovieId" method="post" class="position-absolute top-0 end-0 p-2 z-3">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-light btn-sm rounded-circle shadow-sm text-danger" title="Remove from Favorites">
                                <i class="fas fa-heart fs-6"></i>
                            </button>
                        </form>

                        <!-- صورة الفيلم -->
                        <img src="@imgPath" class="card-img-top rounded-top" style="height: 280px; object-fit: cover;" onerror="this.src='/assets/img/generic/placeholder.png'" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark text-truncate">@item.Movie?.Name</h5>
                            <p class="card-text text-success fw-bold mb-3">$@item.Movie?.Price</p>

                            <div class="mt-auto d-grid gap-2">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@item.MovieId" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-info-circle me-1"></i> View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-3">
                <i class="far fa-heart fa-4x text-muted opacity-50"></i>
            </div>
            <h4 class="text-muted">Your favorites list is empty!</h4>
            <p class="text-muted small">Explore our movies list and add your favorite movies here.</p>
            <a asp-controller="Home" asp-action="Index" asp-area = "Customer" class="btn btn-primary px-4 mt-2">
                Browse Movies
            </a>
        </div>
    }
</div>