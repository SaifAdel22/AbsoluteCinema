@model AbsoluteCinema.ViewModels.MovieVM

@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            
            <!-- Card Details Container -->
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="row g-0">
                    
                    <!-- Movie Image / Poster Column -->
                    <div class="col-md-5 bg-dark d-flex align-items-center justify-content-center p-3">
                        @{
                            var posterPath = string.IsNullOrEmpty(Model.ExistingMainImg) 
                                ? "/assets/img/generic/placeholder.png" 
                                : (Model.ExistingMainImg.StartsWith("images/") || Model.ExistingMainImg.StartsWith("/")
                                    ? "/" + Model.ExistingMainImg.TrimStart('/')
                                    : "/images/movies/main/" + Model.ExistingMainImg);
                        }
                        <img src="@posterPath" alt="@Model.Title" class="img-fluid rounded shadow w-100" style="max-height: 450px; object-fit: cover;" />
                    </div>

                    <!-- Movie Information Column -->
                    <div class="col-md-7 d-flex flex-column justify-content-between bg-white p-4">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h1 class="fw-bold text-dark fs-3 mb-0">@Model.Title</h1>
                                @if (Model.Status)
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2 rounded-pill">Unavailable</span>
                                }
                            </div>

                            <p class="text-muted mb-2">
                                <i class="fas fa-film text-primary me-2"></i><strong>Genre:</strong> @Model.CategoryName
                            </p>
                            <p class="text-muted mb-2">
                                <i class="far fa-calendar-alt text-info me-2"></i><strong>Show Time:</strong> @Model.StartDate.ToString("dd MMM yyyy, hh:mm tt")
                            </p>
                            <p class="text-success fs-5 fw-bold mb-3">
                                <i class="fas fa-tag me-2"></i>$@Model.Price.ToString("0.00")
                            </p>

                            <hr class="text-muted" />
                            <p class="text-muted small lh-base mb-4">@Model.Description</p>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                                <i class="fas fa-arrow-left me-1"></i> Back to List
                            </a>

                            <div class="d-flex align-items-center gap-2">
                                <form asp-controller="Favorite" asp-action="AddToFavorites" asp-route-movieId="@Model.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-2 shadow-sm" title="Add to Favorites">
                                        <i class="far fa-heart fs-5"></i>
                                    </button>
                                </form>

                                @if (Model.Status)
                                {
                                    <button type="button" class="btn btn-primary px-4 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#seatSelectionModal">
                                        <i class="fas fa-ticket-alt me-1"></i> Buy Tickets
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary px-4 shadow-sm fw-bold" disabled>Sold Out</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ================= Modal: Real Database Seats Selection ================= -->
<div class="modal fade" id="seatSelectionModal" tabindex="-1" aria-labelledby="seatSelectionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="seatSelectionModalLabel">
                    <i class="fas fa-chair text-primary me-2"></i> Select Seats - @Model.Title
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <!-- Form submitting to AddToCart Action -->
            <form asp-controller="Cart" asp-action="AddToCart" asp-route-movieId="@Model.Id" method="post" id="cartForm">
                @Html.AntiForgeryToken()
                
                <div class="modal-body text-center py-4">
                    <p class="text-muted mb-3">Select your available seats from the screen below:</p>

                    <!-- DEBUG LINE - هنشيلها بعدين -->
                    <p class="text-warning fw-bold">DEBUG: MovieId=@Model.Id | SeatsCount=@Model.Seats.Count()</p>

                    <div class="bg-secondary text-white py-2 mb-4 rounded w-75 mx-auto fw-bold tracking-wider small shadow-sm">
                        SCREEN THIS WAY
                    </div>
                    ...

                    <!-- Dynamic Seats Grid from Database -->
                    <div class="seat-container p-3 bg-light rounded mb-3 d-flex flex-column align-items-center gap-2 overflow-auto" style="max-height: 350px;">
                        @if (Model.Seats != null && Model.Seats.Any())
                        {
                            var groupedSeats = Model.Seats.GroupBy(s => s.SeatNumber.Substring(0, 1)).OrderBy(g => g.Key);
                            foreach (var group in groupedSeats)
                            {
                                <div class="d-flex justify-content-center align-items-center gap-2 w-100">
                                    <span class="fw-bold text-muted me-2" style="width: 20px;">@group.Key</span>
                                    @foreach (var seat in group.OrderBy(s => int.Parse(s.SeatNumber.Substring(1))))
                                    {
                                        if (seat.IsBooked)
                                        {
                                            <!-- Seat is Booked (Dark / Disabled) -->
                                            <span class="badge bg-dark text-white p-2"
                                                  style="width: 38px; height: 32px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; cursor: not-allowed; border: 2px solid #000;"
                                                  title="Booked  ">
                                                <i class="fas fa-lock" style="font-size: 0.7rem;"></i>
                                            </span>
                                        }
                                        else
                                        {
                                            <!-- Seat is Available (Clickable) -->
                                            <span class="badge bg-secondary seat-badge" 
                                                  data-seat-id="@seat.Id"
                                                  data-seat-number="@seat.SeatNumber"
                                                  style="cursor: pointer; width: 38px; height: 32px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; user-select: none;"
                                                  title="Available">
                                                @seat.SeatNumber
                                            </span>
                                        }
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-danger">No seats available for this movie yet!</p>
                        }
                    </div>

                    <!-- Legend -->
                    <div class="d-flex justify-content-center gap-4 mb-3 small text-muted">
                        <span><i class="fas fa-square text-secondary"></i> Available</span>
                        <span><i class="fas fa-square text-success"></i> Selected</span>
                        <span><i class="fas fa-square text-dark"></i> Booked</span>
                    </div>

                    <!-- Hidden inputs or dynamic checkboxes for sending seatIds to CartService.Add -->
                    <div id="selectedSeatsInputs"></div>

                    <!-- Selection Summary -->
                    <div class="mt-3 text-secondary bg-white p-2 rounded border">
                        <span class="fw-bold">Selected Seats: <span id="seatsTextDisplay" class="text-dark">None</span></span>
                        <span class="ms-4 fw-bold">Total Count: <span id="countDisplay" class="text-primary">0</span></span>
                        <span class="ms-4 fw-bold">Total Price: <span id="totalPriceDisplay" class="text-success">$0.00</span></span>
                    </div>
                </div>
                
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm px-4 fw-bold" id="confirmBtn" disabled>
                        <i class="fas fa-cart-plus me-1"></i> Confirm & Add to Cart
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const moviePrice = @Model.Price;
        const seatBadges = document.querySelectorAll('.seat-badge');
        const countDisplay = document.getElementById('countDisplay');
        const totalPriceDisplay = document.getElementById('totalPriceDisplay');
        const seatsTextDisplay = document.getElementById('seatsTextDisplay');
        const selectedSeatsInputs = document.getElementById('selectedSeatsInputs');
        const confirmBtn = document.getElementById('confirmBtn');

        let selectedSeatIds = [];
        let selectedSeatNumbers = [];

        seatBadges.forEach(seat => {
            seat.addEventListener('click', function () {
                const seatId = this.getAttribute('data-seat-id');
                const seatNum = this.getAttribute('data-seat-number');

                if (this.classList.contains('bg-success')) {
                    // Deselect
                    this.classList.remove('bg-success');
                    this.classList.add('bg-secondary');
                    selectedSeatIds = selectedSeatIds.filter(id => id !== seatId);
                    selectedSeatNumbers = selectedSeatNumbers.filter(num => num !== seatNum);
                } else {
                    // Select
                    this.classList.remove('bg-secondary');
                    this.classList.add('bg-success');
                    selectedSeatIds.push(seatId);
                    selectedSeatNumbers.push(seatNum);
                }

                // Update Summary
                const count = selectedSeatIds.length;
                countDisplay.textContent = count;
                totalPriceDisplay.textContent = '$' + (count * moviePrice).toFixed(2);
                seatsTextDisplay.textContent = count > 0 ? selectedSeatNumbers.join(', ') : 'None';

                // Re-populate hidden inputs so Controller receives `List<int> seatIds`
                selectedSeatsInputs.innerHTML = '';
                selectedSeatIds.forEach(id => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'seatIds';
                    input.value = id;
                    selectedSeatsInputs.appendChild(input);
                });

                // Enable/Disable Confirm Button
                if (count > 0) {
                    confirmBtn.removeAttribute('disabled');
                } else {
                    confirmBtn.setAttribute('disabled', 'true');
                }
            });
        });
    </script>
}