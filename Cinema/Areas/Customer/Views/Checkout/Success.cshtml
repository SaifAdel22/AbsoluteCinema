@{
    ViewData["Title"] = "Payment Successful";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-0 py-5 px-4">
                <div class="mb-4">
                    <i class="fas fa-check-circle text-success fa-5x"></i>
                </div>
                <h2 class="fw-bold text-dark mb-3">Payment Successful!</h2>
                <p class="text-muted mb-4">
                    Thank you for your purchase. Your movie tickets have been successfully booked and confirmed. Enjoy the show!
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 fw-bold">
                        Browse More Movies
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>